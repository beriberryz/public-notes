views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink("01 areas/Pagsasarili at Pambansang Pagpapasya")
  - type: cards
    name: View
    filters:
      and:
        - file.hasLink("01 areas/Pagsasarili at Pambansang Pagpapasya")
    order:
      - file.name
      - term
    sort:
      - property: file.ctime
        direction: ASC
    image: note.cover
    imageAspectRatio: 1.45
    cardSize: 210
