THEME=https://raw.githubusercontent.com/slrvb/Obsidian--ITS-Theme/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=false
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=false
dgShowToc=true
dgLinkPreview=false
dgShowTags=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --radius-s: 0px; --bold-weight: 900; } body.theme-light.css-settings-manager { --bold-color: #163F9C; } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=mod-macos is-frameless is-hidden-frameless obsidian-app theme-light is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager Heading its-theme sidebar-float-bottom folder-arrow-hidden justified check-color check-bg pathfinder-remaster is-maximized
SITE_NAME_HEADER=Notes ni Kirsten
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=https://public-notes-blush.vercel.app/
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=true
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false